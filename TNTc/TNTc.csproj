<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>tntc-logo.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <PackAsTool>true</PackAsTool>
    <PackageId>TNTC</PackageId>
    <ToolCommandName>tntc</ToolCommandName>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Description>TNTC is a command-line tool designed to help manage translations in .NET projects.</Description>
    <PackageTags>Translation, languages, multi-language user interface, UI translation</PackageTags>
    <PackageIcon>tntc-logo.png</PackageIcon>
    <Authors>Curiosity GmbH</Authors>
    <Company>Curiosity GmbH</Company>
    <Copyright>(c) Copyright 2025 Curiosity GmbH - all right reserved</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.13.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tntc-logo.png" Pack="true" PackagePath="\"/>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
    <!-- The Claude Code skill that drives the extract/missing/apply/verify loop. Embedded so
         'tntc install-skill' can write it into a consuming repo's .claude/skills/ folder (a dotnet
         tool package cannot be PackageReference'd, so there is no MSBuild hook to copy it from the
         package); also packed under skills/ so the nupkg content is inspectable. -->
    <None Include="..\.claude\skills\tntc-translate\**" Pack="true" PackagePath="skills\tntc-translate"/>
    <EmbeddedResource Include="..\.claude\skills\tntc-translate\**" LogicalName="skills/tntc-translate/%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
